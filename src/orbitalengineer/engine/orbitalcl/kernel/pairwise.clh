#ifndef PAIRWISE_CLH_
#define PAIRWISE_CLH_

typedef struct {
    const uint idx;
    const uint i;
    const uint j;
} Pair;

inline uint triu_index(uint i, uint j, uint N) {
    return i * (N - 1u) - (i * (i - 1u)) / 2u + (j - i - 1u);
}

#define PAIR_STRIDE_INIT()                    \
    uint i = get_group_id(0);                 \
    uint lane = get_local_id(0);              \
    uint Lx = get_local_size(0);


#define PAIR_STRIDE_IJ( ...)                  \
    do {                                      \
        if (i >= N) return;                   \
        uint row_start = i * N;               \
        for (uint j = lane; j < N; j += Lx) { \
            if (j == i) continue;             \
            uint const IDX = row_start + j;   \
            __VA_ARGS__;                      \
        }                                     \
    } while (0)

#endif // PAIRWISE_CLH_
