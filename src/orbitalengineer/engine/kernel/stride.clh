/*
i     = 0..N
lane  = 0..Lx
Lx    = 64, 128, or 256
*/


#define GRID_STRIDE_INIT()                    \
    uint i = get_group_id(0);                 \
    uint lane = get_local_id(0);              \
    uint Lx = get_local_size(0);


#define GRID_STRIDE_IJ( ...)                                \
    do {                                                    \
        uint row_start = i * N_bodies_alloc;                \
        for (uint j = lane; j < N_bodies_valid; j += Lx) {  \
            if (j == i) continue;                           \
            uint const IDX = row_start + j;                 \
            __VA_ARGS__;                                    \
        }                                                   \
    } while (0)
