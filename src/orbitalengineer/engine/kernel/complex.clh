#ifndef COMPLEX_CLH_
#define COMPLEX_CLH_
#include "dtype.clh"


// -----------------------------------------------------------------------------
// Constructors / accessors
// -----------------------------------------------------------------------------

// complex_new(re, im): Construct a complex number (re + i*im).
inline COMPLEX complex_new(REAL re, REAL im) {
    return (COMPLEX)(re, im);
}

// creal(z): Extract real component.
inline REAL creal(COMPLEX z) {
    return z.x;
}

// cimag(z): Extract imaginary component.
inline REAL cimag(COMPLEX z) {
    return z.y;
}

// -----------------------------------------------------------------------------
// Basic arithmetic
// -----------------------------------------------------------------------------

// cadd(a, b): Complex addition.
inline COMPLEX cadd(COMPLEX a, COMPLEX b) {
    return a + b;
}

// csub(a, b): Complex subtraction.
inline COMPLEX csub(COMPLEX a, COMPLEX b) {
    return a - b;
}

// cneg(a): Complex negation.
inline COMPLEX cneg(COMPLEX a) {
    return -a;
}

// cconj(a): Complex conjugate (re, -im).
inline COMPLEX cconj(COMPLEX a) {
    return (COMPLEX)(a.x, -a.y);
}

// -----------------------------------------------------------------------------
// Scaling by real scalars
// -----------------------------------------------------------------------------

// cscale(z, s): Real scalar multiply → (s*re, s*im).
inline COMPLEX cscale(COMPLEX z, REAL s) {
    return z * s;
}

// cscale_inv(z, s): Real scalar divide → (re/s, im/s).
inline COMPLEX cscale_inv(COMPLEX z, REAL s) {
    return z / s;
}

// -----------------------------------------------------------------------------
// Complex multiplication
// -----------------------------------------------------------------------------

// cmul(a, b): Complex multiply → (ar*br - ai*bi, ar*bi + ai*br).
inline COMPLEX cmul(COMPLEX a, COMPLEX b) {
    return (COMPLEX)(
        a.x*b.x - a.y*b.y,
        a.x*b.y + a.y*b.x
    );
}

// cmul_conj(a, b): a * conj(b) → useful for dot products / correlations.
inline COMPLEX cmul_conj(COMPLEX a, COMPLEX b) {
    return (COMPLEX)(
        a.x*b.x + a.y*b.y,
        a.y*b.x - a.x*b.y
    );
}

// -----------------------------------------------------------------------------
// Magnitude, magnitude squared
// -----------------------------------------------------------------------------

// cabs2(a): Squared magnitude → re^2 + im^2.
// Fast and preferred when comparing magnitudes.
inline REAL cabs2(COMPLEX a) {
    return dot(a, a);
}

// cabs(a): Magnitude → sqrt(re^2 + im^2).
inline REAL cabs(COMPLEX a) {
    return sqrt(dot(a, a));
}

// -----------------------------------------------------------------------------
// Normalization
// -----------------------------------------------------------------------------

// cnormalize(a): Normalize to unit magnitude; returns 0 if |a|=0.
inline COMPLEX cnormalize(COMPLEX a) {
    REAL m = cabs(a);
    return (m > 0.0f) ? a / m : (COMPLEX)(0.0f, 0.0f);
}

// cnormalize_safe(a, eps): Normalize with epsilon guard for stability.
// eps is the *magnitude* threshold (not squared).
inline COMPLEX cnormalize_safe(COMPLEX a, REAL eps) {
    REAL m2 = cabs2(a);
    REAL eps2 = eps * eps;
    if (m2 < eps2)
        return (COMPLEX)(0.0f, 0.0f);

    REAL inv_m = rsqrt(m2);  // Fast and accurate on GPUs.
    return a * inv_m;
}

// -----------------------------------------------------------------------------
// Complex division
// -----------------------------------------------------------------------------

// cdiv(a, b): Complex division a/b using standard rationalized form.
// Caller should ensure b ≠ 0 (no guards here for speed).
inline COMPLEX cdiv(COMPLEX a, COMPLEX b) {
    REAL denom = b.x*b.x + b.y*b.y;
    REAL inv = 1.0f / denom;

    REAL real = (a.x*b.x + a.y*b.y) * inv;
    REAL imag = (a.y*b.x - a.x*b.y) * inv;

    return (COMPLEX)(real, imag);
}

#endif // COMPLEX_CLH_
